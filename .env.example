# ==============================================================================
# DROPIA LOGISTICS SAAS - CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# Architecture : React + Vite (Frontend) | Firebase + Cloud Functions (Backend) | PayDunya (Paiement)
# ==============================================================================
#
# RÈGLES D'ISOLATION ET DE SÉCURITÉ :
# 1. FRONTEND : Seules les variables préfixées par VITE_ sont injectées par Vite dans le navigateur.
#    Ces variables sont PUBLIQUES (incluses dans le bundle client JS). La sécurité repose sur les
#    règles de sécurité Firestore (firestore.rules) et Firebase Auth, JAMAIS sur ces clés.
# 2. BACKEND : Toutes les variables sans préfixe VITE_ sont STRICTEMENT PRIVÉES et réservées
#    au serveur (Node.js, Cloud Functions, webhooks). Elles ne doivent JAMAIS être exposées au client.
# 3. DOUBLONS CORRIGÉS : Suppression de toutes les variables NEXT_PUBLIC_* et doublons de clés.
# ==============================================================================

# ------------------------------------------------------------------------------
# CATÉGORIE A : FRONTEND (Vite / Navigateur Client) — Variables Publiques
# ------------------------------------------------------------------------------
# Configuration SDK Web Firebase v10+ (Appeler via import.meta.env.VITE_*)
VITE_FIREBASE_API_KEY="AIzaSyAbfpjuFnGsc0WpeF2NRaBkakIAywPPa1s"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0931623547.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0931623547"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0931623547.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="52890772502"
VITE_FIREBASE_APP_ID="1:52890772502:web:0693804f80b2b98c0c8137"
VITE_APP_ENV="production"

# ------------------------------------------------------------------------------
# CATÉGORIE B : BACKEND PRIVÉ (Cloud Functions / API Node / Webhooks) — Clés Secrètes
# ------------------------------------------------------------------------------
# ATTENTION : NE JAMAIS PRÉFIXER CES VARIABLES PAR VITE_ !

# --- 1. Firebase Admin SDK (Privilèges administratifs totaux / Accès système) ---
FIREBASE_PROJECT_ID="gen-lang-client-0931623547"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@gen-lang-client-0931623547.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_KEY=""

# --- 2. SasPay & Passerelles Mobile Money (Wave, Orange Money, Free Money, Moov, MTN, Cartes) ---
# Clé secrète de production SasPay (https://docs.saspay.me/)
SASPAY_API_KEY="sk_live_your_saspay_secret_key_here"
SASPAY_SECRET_KEY="sk_live_your_saspay_secret_key_here"

# PayDunya (Passerelle secondaire optionnelle)
PAYDUNYA_MASTER_KEY="your_paydunya_master_key_here"
PAYDUNYA_PRIVATE_KEY="your_paydunya_private_key_here"
PAYDUNYA_TOKEN="your_paydunya_token_here"
PAYDUNYA_MODE="live"

# --- 3. Configuration d'exécution Serveur AI Studio ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

