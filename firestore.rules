rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================================================
    // FONCTIONS UTILITAIRES DE SÉCURITÉ
    // ==========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Récupération du document utilisateur courant
    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == 'franquetzzogni6@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && currentUserDoc().role == 'admin')
      );
    }

    function isMerchantOwner(merchantId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentUserDoc().role == 'merchant' &&
        currentUserDoc().merchantId == merchantId
      );
    }

    function isAgencyOwner(agencyId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentUserDoc().role == 'agency' &&
        currentUserDoc().agencyId == agencyId
      );
    }

    function isDriverAssigned(driverId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentUserDoc().role == 'driver' &&
        currentUserDoc().driverId == driverId
      );
    }

    // ==========================================================================
    // 1. COLLECTION: users & utilisateurs
    // ==========================================================================
    match /users/{userId} {
      allow read, write: if true;
    }

    match /utilisateurs/{userId} {
      allow read, write: if true;
    }

    // ==========================================================================
    // MULTI-ROLES & PRODUCTION COLLECTIONS (Dropia)
    // ==========================================================================
    match /agences/{agencyId} {
      allow read, write: if true;
    }

    match /ecommercants/{ecomId} {
      allow read, write: if true;
    }

    match /livreurs/{livreurId} {
      allow read, write: if true;
    }

    match /paiements_abonnements/{paiementId} {
      allow read, write: if true;
    }

    match /merchants/{merchantId} {
      allow read, write: if true;
    }

    match /agencies/{agencyId} {
      allow read, write: if true;
    }

    match /drivers/{driverId} {
      allow read, write: if true;
    }

    match /commandes/{cmdId} {
      allow read, write: if true;
    }

    match /paiements/{pId} {
      allow read, write: if true;
    }

    match /transactions_sasapay/{tId} {
      allow read, write: if true;
    }

    match /decaissements_sasapay/{dId} {
      allow read, write: if true;
    }

    match /notifications/{nId} {
      allow read, write: if true;
    }

    match /historique_abonnements/{hId} {
      allow read, write: if true;
    }

    match /api_logs/{logId} {
      allow read, write: if true;
    }

    match /webhook_deliveries/{delivId} {
      allow read, write: if true;
    }

    match /positions_livreurs/{posId} {
      allow read, write: if true;
    }

    match /suivis/{sId} {
      allow read, write: if true;
    }

    match /historique_positions/{hposId} {
      allow read, write: if true;
    }

    match /wallets/{wId} {
      allow read, write: if true;
    }

    match /portefeuilles/{portId} {
      allow read, write: if true;
    }

    match /analytics/{aId} {
      allow read, write: if true;
    }

    // ==========================================================================
    // 5. COLLECTION: orders & colis
    // ==========================================================================
    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /colis/{colisId} {
      allow read, write: if true;
    }

    // ==========================================================================
    // 6. COLLECTION: deliveries
    // ==========================================================================
    match /deliveries/{deliveryId} {
      allow read, write: if true;
    }

    // ==========================================================================
    // 7. COLLECTION: transactions
    // ==========================================================================
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // ==========================================================================
    // 8. SONDE DE CONNECTIVITÉ: test (Health Check)
    // ==========================================================================
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // ==========================================================================
    // 9. API REST & WEBHOOKS (Plan Business)
    // ==========================================================================
    match /api_keys/{keyId} {
      allow read: if true;
      allow write: if true;
    }

    match /webhooks/{webhookId} {
      allow read: if true;
      allow write: if true;
    }

    match /webhook_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================================================
    // 10. ADMINISTRATION GLOBALE DROPIA (Super Admin)
    // ==========================================================================
    match /admins/{adminId} {
      allow read, write: if true;
    }

    match /plateforme_config/{configId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}
